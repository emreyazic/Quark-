/* JLCPCB BOM Tool — calm, accessible desktop theme */

QWidget {
    background-color: #0b1220;
    color: #e5e7eb;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog { background-color: #0b1220; }
QWidget#appHeader { background: transparent; }

QWidget#contentPanel, QFrame#actionBar, QFrame#summaryFrame {
    background-color: #111827;
    border: 1px solid #263449;
    border-radius: 10px;
}

QFrame#headerSeparator {
    background-color: #263449;
    border: none;
    max-height: 1px;
}

QGroupBox {
    background-color: #111827;
    border: 1px solid #263449;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    color: #dbeafe;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 8px;
    background-color: #111827;
    color: #93c5fd;
}

QLabel { background: transparent; color: #cbd5e1; }
QLabel#titleLabel { color: #f8fafc; font-size: 24px; font-weight: 700; }
QLabel#subtitleLabel { color: #94a3b8; font-size: 13px; }
QLabel#sectionTitle { color: #f1f5f9; font-size: 16px; font-weight: 700; padding-bottom: 4px; }
QLabel#fieldLabel { color: #cbd5e1; font-weight: 600; min-width: 54px; }
QLabel#statusLabel { color: #93c5fd; font-size: 12px; padding: 5px 2px; }

QLabel#versionBadge {
    background-color: #172554;
    color: #bfdbfe;
    border: 1px solid #1e3a8a;
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#footerLabel { color: #64748b; font-size: 10px; padding-top: 8px; }

QPushButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover { background-color: #27364b; border-color: #60a5fa; color: #ffffff; }
QPushButton:pressed { background-color: #172033; border-color: #3b82f6; }
QPushButton:focus { border: 2px solid #60a5fa; padding: 7px 13px; }
QPushButton:disabled { background-color: #111827; color: #5f6f85; border-color: #243044; }

QPushButton#btnProcess {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
    padding: 10px 24px;
    min-height: 24px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#btnProcess:hover { background-color: #047857; border-color: #34d399; }
QPushButton#btnProcess:pressed { background-color: #065f46; }
QPushButton#btnProcess:disabled { background-color: #173a35; color: #6f948d; border-color: #245148; }

QPushButton#btnDanger { background-color: #7f1d1d; color: #fee2e2; border-color: #b91c1c; }
QPushButton#btnDanger:hover { background-color: #991b1b; border-color: #ef4444; }

QLineEdit, QComboBox, QSpinBox {
    background-color: #0f172a;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 20px;
    selection-background-color: #2563eb;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #475569; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #3b82f6; padding: 6px 9px; }
QLineEdit:read-only { background-color: #101827; color: #94a3b8; }
QComboBox::drop-down { border: none; width: 28px; }

QComboBox QAbstractItemView {
    background-color: #111827;
    color: #e5e7eb;
    border: 1px solid #334155;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    padding: 4px;
}

QTableWidget, QTableView, QTreeWidget {
    background-color: #0f172a;
    alternate-background-color: #121c2e;
    color: #e2e8f0;
    border: 1px solid #263449;
    border-radius: 7px;
    gridline-color: #243044;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item, QTreeWidget::item {
    padding: 7px 8px;
    border-bottom: 1px solid #1d293b;
}

QTableWidget::item:hover, QTableView::item:hover, QTreeWidget::item:hover { background-color: #17243a; }
QTableWidget::item:selected, QTableView::item:selected, QTreeWidget::item:selected { background-color: #1d4ed8; color: #ffffff; }

QHeaderView::section {
    background-color: #172033;
    color: #bfdbfe;
    border: none;
    border-right: 1px solid #2b3a50;
    border-bottom: 1px solid #3b82f6;
    padding: 9px 10px;
    font-size: 12px;
    font-weight: 700;
}

QHeaderView::section:hover { background-color: #1e2c43; }

QTabWidget::pane {
    background-color: #0f172a;
    border: 1px solid #263449;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 16px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:selected { color: #f8fafc; border-bottom-color: #3b82f6; }
QTabBar::tab:hover:!selected { color: #dbeafe; background-color: #172033; }

QTextEdit, QPlainTextEdit {
    background-color: #080f1c;
    color: #b9c7da;
    border: 1px solid #263449;
    border-radius: 7px;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    selection-background-color: #1d4ed8;
}

QProgressBar {
    background-color: #111827;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 7px;
    min-height: 24px;
    text-align: center;
    font-weight: 700;
}

QProgressBar::chunk { background-color: #059669; border-radius: 6px; }

QFrame#dropArea {
    background-color: #0f172a;
    border: 2px dashed #3b4a60;
    border-radius: 10px;
    min-height: 104px;
}

QFrame#dropArea:hover { background-color: #111d31; border-color: #60a5fa; }
QLabel#dropTitle { color: #dbeafe; font-size: 14px; font-weight: 600; }
QLabel#dropHint { color: #7f8ea3; font-size: 11px; }

QMenu {
    background-color: #111827;
    color: #e5e7eb;
    border: 1px solid #334155;
    padding: 5px;
}

QMenu::item { padding: 7px 24px 7px 10px; border-radius: 4px; }
QMenu::item:selected { background-color: #1d4ed8; color: #ffffff; }

QCheckBox { color: #d7e0ec; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; }

QSplitter::handle { background-color: transparent; width: 10px; height: 10px; }
QSplitter::handle:hover { background-color: #263449; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background-color: #3b4a60; border-radius: 4px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background-color: #64748b; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background-color: #3b4a60; border-radius: 4px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background-color: #64748b; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QToolTip { background-color: #1e293b; color: #f8fafc; border: 1px solid #60a5fa; padding: 6px 9px; }

QLabel#badgeFound, QLabel#badgeNotFound, QLabel#badgeOOS, QLabel#badgeOther {
    border-radius: 9px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#badgeFound { background-color: #065f46; color: #d1fae5; border: 1px solid #059669; }
QLabel#badgeNotFound { background-color: #7f1d1d; color: #fee2e2; border: 1px solid #b91c1c; }
QLabel#badgeOOS { background-color: #78350f; color: #fef3c7; border: 1px solid #b45309; }
QLabel#badgeOther { background-color: #4c1d95; color: #ede9fe; border: 1px solid #7c3aed; }
