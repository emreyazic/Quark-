{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "core",
    "models",
    "services"
  ],
  "exclude": ["**/__pycache__"],
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none",
  "reportOptionalMemberAccess": "warning",
  "reportIncompatibleMethodOverride": "warning"
}
